# ─── AutoFin Configuration ───────────────────────────────────────────
# Copy to .env and fill in your values.

# ── Auth ─────────────────────────────────────────────────────────────
# Set a password to gate the UI. Leave empty to disable auth (dev only).
AUTOFIN_PASSWORD=
# JWT signing key. Generate with: openssl rand -hex 32
AUTOFIN_SECRET_KEY=change-me-to-a-random-string
# Token lifetime in hours
AUTOFIN_TOKEN_EXPIRE_HOURS=72
# Separate token for cron/n8n automation endpoints.
# Generate with: openssl rand -hex 32
# AUTOFIN_AUTOMATION_TOKEN=

# ── Database ─────────────────────────────────────────────────────────
# Docker: /data/autofin.db · Local: ~/.autofin/autofin.db
# AUTOFIN_DB_PATH=/data/autofin.db

# ── SimpleFin (optional) ─────────────────────────────────────────────
# After running setup in the UI, paste the returned access URL here.
# AUTOFIN_SIMPLEFIN_ACCESS_URL=
# Accounts are considered sync-stale when last successful SimpleFIN sync is this many days old.
AUTOFIN_SIMPLEFIN_STALE_DAYS=3

# ── AI Provider ──────────────────────────────────────────────────────
# Provider: ollama (default), openai, anthropic. Can also be set from Settings.
AUTOFIN_AI_PROVIDER=ollama
AUTOFIN_AI_MODEL=llama3.1
# Ollama: http://localhost:11434 (local) or http://ollama:11434 (docker)
# OpenAI: https://api.openai.com
# Anthropic: https://api.anthropic.com
AUTOFIN_AI_BASE_URL=http://localhost:11434
# Required for openai/anthropic. Not used for ollama.
# AUTOFIN_AI_API_KEY=

# ── Server ───────────────────────────────────────────────────────────
AUTOFIN_HOST=0.0.0.0
AUTOFIN_PORT=8000
# Comma-separated list of allowed frontend origins.
# AUTOFIN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
